<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- K29: the launcher logic is a library so the console and GUI binaries can be two thin entry
         points over one implementation instead of two copies that drift apart. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Runly.Launcher</RootNamespace>
    <AssemblyName>Runly.Launcher</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Required for the [UnmanagedCallersOnly] TaskDialog / window procedure callbacks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Enforces the "one XML doc line per type" rule from SPEC 11 via CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Runly.Core\Runly.Core.csproj" />
  </ItemGroup>

</Project>
