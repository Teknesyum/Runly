<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Runly.Launcher</RootNamespace>
    <!-- SPEC 3: the shipped binary is Runly.exe. -->
    <AssemblyName>Runly</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- SPEC 3 size budget: no stack traces, no localised framework resource strings. -->
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Required for the [UnmanagedCallersOnly] TaskDialog / window procedure callbacks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SPEC 6: comctl32 v6 + PerMonitorV2 + longPathAware. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\runly.ico</ApplicationIcon>
    <!-- Enforces the "one XML doc line per type" rule from SPEC 11 via CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Runly.Core\Runly.Core.csproj" />
  </ItemGroup>

</Project>
