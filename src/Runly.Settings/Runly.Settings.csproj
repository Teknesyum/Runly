<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Runly.Settings</RootNamespace>
    <AssemblyName>RunlySettings</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SPEC 10 / T5: per-monitor v2 DPI awareness, set at the project level (no manifest). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\runly.ico</ApplicationIcon>
    <!-- SPEC 3: WinForms does not support trimming or AOT. Never turn these on. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Runly.Core\Runly.Core.csproj" />
    <EmbeddedResource Include="..\..\assets\runly.ico" LogicalName="Runly.Settings.runly.ico" />
    <EmbeddedResource Include="locale\tr.json" LogicalName="Runly.Settings.locale.tr.json" />
    <EmbeddedResource Include="locale\en.json" LogicalName="Runly.Settings.locale.en.json" />
  </ItemGroup>

</Project>
